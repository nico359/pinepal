<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.pinepal</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>PinePal</name>
  <summary>Companion app for PineTime watches</summary>
  <description>
    <p>PinePal is a companion app for PineTime smartwatches running InfiniTime. Connect via Bluetooth LE to view battery, heart rate, and step count, forward notifications from your phone, and track your step history over time.</p>
  </description>

  <icon type="stock">io.github.nico359.pinepal</icon>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/pinepal</url>
  <url type="vcs-browser">https://github.com/nico359/pinepal</url>
  <url type="bugtracker">https://github.com/nico359/pinepal/issues</url>

  <recommends>
    <display_length compare="ge">360</display_length>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <supports>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <screenshots>
        <screenshot type="default">
            <caption>Dashboard</caption>
            <image>https://raw.githubusercontent.com/nico359/pinepal/refs/heads/main/data/dashboard.png</image>
        </screenshot>
        <screenshot>
            <caption>Searching</caption>
            <image>https://raw.githubusercontent.com/nico359/pinepal/refs/heads/main/data/searching.png</image>
        </screenshot>
        <screenshot>
            <caption>Bluetooth disabled</caption>
            <image>https://raw.githubusercontent.com/nico359/pinepal/refs/heads/main/data/bluetoothdisabled.png</image>
        </screenshot>
        <screenshot>
            <caption>Mobile</caption>
            <image>https://raw.githubusercontent.com/nico359/loci/refs/heads/main/data/mobile.png</image>
        </screenshot>
    </screenshots>

  <translation type="gettext">pinepal</translation>
  <launchable type="desktop-id">io.github.nico359.pinepal.desktop</launchable>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.3.2" date="2026-06-24">
      <description translate="no">
        <p>Fixed another Bluetooth related bug</p>
        <ul>
          <li>The watch disonnected uncleanly sometimes (stale cache) which resulted in buggy or no reconnection</li>
          <li>The app triggers a proper reconnection now so this should not happen anymore</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-05-22">
      <description translate="no">
        <p>Handle Bluetooth turning off properly.</p>
        <ul>
          <li>Turning off Bluetooth while a connection is active does not break the reconnect logic anymore</li>
          <li>The app now sleeps when Bluetooth is off and attempts reconnecting as soon as it is turned back on</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-05-20">
      <description translate="no">
        <p>Mostly QOL improvements.</p>
        <ul>
          <li>App now reconnects to last known watch automatically on startup</li>
          <li>Autostart via Background Portal (might now work in e.g. Phosh)</li>
          <li>Added ability to cancel a reconnect loop without quitting the app</li>
          <li>Added quit button in the menu that completely kills the app</li>
          <li>Settings moved to a separate page in the menu</li>
          <li>Made initial connection attempt a little bit more obvious</li>
          <li>Somewhat fixed missing icons</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-04-18">
      <description translate="no">
        <p>Stability and usability improvements.</p>
        <ul>
          <li>Added app icon</li>
          <li>Improved BLE reconnection reliability on the FuriPhone</li>
          <li>Removed unnecessary network access from the Flatpak manifest</li>
          <li>Added in-app diagnostic log viewer and export (Ctrl+Shift+D)</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-04-10">
      <description translate="no">
        <p>Initial release.</p>
        <ul>
          <li>BLE connection with automatic reconnection</li>
          <li>Live battery, heart rate, and step count</li>
          <li>Step history chart with daily persistence</li>
          <li>Desktop notification forwarding</li>
          <li>Background mode</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
